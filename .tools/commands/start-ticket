#!/bin/bash
# start-ticket command for Spectrum Development Framework
# Phase 2: Clean Implementation After Context Reset (Android/pCloud Music Player version)
# Purpose: Read PLY ticket info from discover-ticket, set up Android workspace, begin focused implementation

# Configuration
TICKET_INFO_FILE="./tmp/spectrum-ticket-info.json"

# Colors and emoji
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
SUCCESS="✅"
ERROR="❌"
INFO="📋"
WORKING="🔄"
DOWNLOAD="📥"
FOLDER="📁"
BRANCH="🌳"
SAVE="💾"
RESET="🔄"
MUSIC="🎵"
ANDROID="📱"

echo -e "${INFO} ${BLUE}Spectrum Development Framework - Ticket Implementation${NC}"
echo -e "${MUSIC} ${YELLOW}pCloud Music Player (Android) - Phase 2: Clean Implementation${NC}"
echo ""

# Check for ticket info from discover-ticket phase
if [[ -f "$TICKET_INFO_FILE" ]]; then
    echo -e "${SUCCESS} Found ticket info from discovery phase"
    
    # Extract ticket information
    ticket_id=$(jq -r '.ticket_id' "$TICKET_INFO_FILE")
    ticket_title=$(jq -r '.ticket_title' "$TICKET_INFO_FILE")
    downloaded_file=$(jq -r '.ticket_file' "$TICKET_INFO_FILE")
    project=$(jq -r '.project // "pcloud-music-player"' "$TICKET_INFO_FILE")
    platform=$(jq -r '.platform // "android"' "$TICKET_INFO_FILE")
    music_category=$(jq -r '.music_category // "general"' "$TICKET_INFO_FILE")
    
    echo -e "${INFO} Using discovered ticket: ${BLUE}$ticket_id${NC} - $ticket_title"
    echo -e "${INFO} Project: $project ($platform)"
    echo -e "${INFO} Category: $music_category"
    echo -e "${INFO} Ticket file: $downloaded_file"
    
    # Validate PLY ticket format
    if [[ ! $ticket_id =~ ^PLY-[0-9]+$ ]]; then
        echo -e "${ERROR} Invalid PLY ticket format: $ticket_id"
        echo -e "${INFO} Expected format: PLY-123 (for pCloud Music Player tickets)"
        exit 1
    fi
    
    # Validate the discovered file still exists
    if [[ ! -f "$downloaded_file" ]]; then
        echo -e "${ERROR} Discovered ticket file not found: $downloaded_file"
        echo -e "${INFO} Please re-run discovery phase: .tools/spectrum-dev discover-ticket"
        exit 1
    fi
    
else
    echo -e "${ERROR} No ticket info found from discovery phase"
    echo -e "${INFO} Please run discover-ticket first to identify a PLY ticket:"
    echo -e "${INFO} 1. Run: ${BLUE}.tools/spectrum-dev discover-ticket${NC}"
    echo -e "${INFO} 2. Then run: ${BLUE}.tools/spectrum-dev start-ticket${NC}"
    echo ""
    echo -e "${ERROR} Cannot proceed without PLY ticket information"
    exit 1
fi

# Validate ticket file has content
if [[ ! -s "$downloaded_file" ]]; then
    echo -e "${ERROR} Ticket file is empty: $downloaded_file"
    exit 1
fi

echo -e "${SUCCESS} Ready to proceed with PLY ticket: ${BLUE}$ticket_id${NC} - $ticket_title"
echo -e "${SUCCESS} Using ticket file: $downloaded_file ($(wc -l < "$downloaded_file") lines)"

# Android Music Player Domain Detection and Workspace Setup
echo -e "\n${FOLDER} Step 1: Setting up Android Music Player workspace..."

# Intelligent domain detection based on music player categories
case "$music_category" in
    "playback")
        domain="audio-playback"
        echo -e "${INFO} ${MUSIC} Audio playback feature detected - organizing in audio-playback domain"
        ;;
    "integration") 
        domain="pcloud-integration"
        echo -e "${INFO} ${DOWNLOAD} pCloud integration feature detected - organizing in pcloud-integration domain"
        ;;
    "ui")
        domain="user-interface" 
        echo -e "${INFO} ${ANDROID} UI/Compose feature detected - organizing in user-interface domain"
        ;;
    "service")
        domain="background-services"
        echo -e "${INFO} 🔄 Background service feature detected - organizing in background-services domain"
        ;;
    *)
        domain="music-player-core"
        echo -e "${INFO} ${MUSIC} General music player feature - organizing in music-player-core domain"
        ;;
esac

base_path="."
domain_folder="$base_path/$domain"

# Create domain folder if it doesn't exist
if [[ ! -d "$domain_folder" ]]; then
    echo -e "${WORKING} Creating new Android music player domain folder: $domain_folder"
    mkdir -p "$domain_folder"
fi

# Step 2: Copy ticket to domain folder with Android context
echo -e "\n${FOLDER} Step 2: Creating Android ticket documentation..."

# Create clean filename
clean_title=$(echo "$ticket_title" | tr ' ' '-' | tr '[:upper:]' '[:lower:]' | sed 's/[^a-zA-Z0-9-]//g')
ticket_doc_path="$domain_folder/$ticket_id-$clean_title.md"

# Copy complete ticket file to domain folder and enhance with Android context
cp "$downloaded_file" "$ticket_doc_path"

# Add Android development context to ticket documentation
cat >> "$ticket_doc_path" << EOF

---
## Android Development Context (Auto-Generated)

**Project**: pCloud Music Player (Android)  
**Technology Stack**: 
- Language: Kotlin
- UI Framework: Jetpack Compose
- Architecture: MVVM with Repository pattern
- Audio Engine: Media3/ExoPlayer
- Networking: Retrofit + OkHttp
- DI: Hilt/Dagger
- Build System: Gradle

**Development Domain**: $domain  
**Category**: $music_category  

**Key Android Components Likely Needed**:
- Activities/Fragments for UI
- Services for background playback
- Repository for data access (pCloud API)
- ViewModels for UI state management
- Compose UI components
- MediaSession for media controls

**Testing Strategy**:
- Unit tests with JUnit 5 + Mockito
- UI tests with Compose Test
- Integration tests for API calls
- Instrumented tests for Android components

**Quality Tools**:
- ktlint for Kotlin style
- detekt for code quality
- Android Lint for security/performance
- Gradle for build validation

---
*Generated by Spectrum Development Framework for Android*
EOF

echo -e "${SUCCESS} Created complete Android ticket documentation: $ticket_doc_path"

# Step 3: Create feature branch
echo -e "\n${BRANCH} Step 3: Creating feature branch..."

# Ensure we're on main/master branch or detect default branch
current_branch=$(git branch --show-current)
default_branch=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5 2>/dev/null || echo "main")

if [[ "$current_branch" != "$default_branch" ]]; then
    echo -e "${WORKING} Switching to $default_branch branch..."
    git checkout "$default_branch" || {
        echo -e "${ERROR} Failed to checkout $default_branch branch"
        echo -e "${INFO} Trying alternative default branches..."
        
        # Try common default branch names
        for branch in main master dev develop; do
            if git show-ref --verify --quiet "refs/heads/$branch"; then
                echo -e "${WORKING} Switching to $branch branch..."
                git checkout "$branch" && default_branch="$branch" && break
            fi
        done
        
        if [[ "$(git branch --show-current)" == "$current_branch" ]]; then
            echo -e "${ERROR} Could not find suitable base branch"
            exit 1
        fi
    }
fi

# Pull latest from default branch
echo -e "${WORKING} Pulling latest $default_branch branch..."
git pull origin "$default_branch" || {
    echo -e "${ERROR} Failed to pull latest $default_branch"
    exit 1
}

# Create feature branch with PLY prefix
branch_name="feature/$ticket_id-$clean_title"
echo -e "${WORKING} Creating Android feature branch: $branch_name"
git checkout -b "$branch_name" || {
    echo -e "${ERROR} Failed to create feature branch"
    exit 1
}

echo -e "${SUCCESS} Created and switched to feature branch: $branch_name"

# Step 4: Save workflow state with Android/Music Player context
echo -e "\n${SAVE} Step 4: Saving Android Music Player workflow state..."

mkdir -p .spectrum
cat > .spectrum/current-ticket.json << EOF
{
  "ticket": "$ticket_id",
  "title": "$ticket_title",
  "domain": "$domain",
  "base_path": "$base_path",
  "domain_folder": "$domain_folder",
  "ticket_doc_path": "$ticket_doc_path",
  "branch": "$branch_name",
  "phase": "started",
  "created": "$(date -Iseconds)",
  "source_file": "$downloaded_file",
  "project": "$project",
  "platform": "$platform",
  "music_category": "$music_category",
  "technology_stack": {
    "language": "kotlin",
    "ui_framework": "jetpack_compose", 
    "architecture": "mvvm_repository",
    "audio_engine": "media3_exoplayer",
    "build_system": "gradle"
  }
}
EOF

echo -e "${SUCCESS} Android workflow state saved to .spectrum/current-ticket.json"

# Summary and next steps
echo -e "\n${SUCCESS} ${MUSIC} Android Music Player ticket workflow initialized successfully!"
echo -e "${INFO} Summary:"
echo "  Ticket: $ticket_id - $ticket_title"
echo "  Project: pCloud Music Player (Android)"
echo "  Domain: $domain ($base_path)"
echo "  Category: $music_category"
echo "  Documentation: $ticket_doc_path"
echo "  Branch: $branch_name"
echo "  Complete ticket details: $(wc -l < "$ticket_doc_path") lines"
echo ""
echo -e "${INFO} ${ANDROID} Android Development Next Steps:"
echo "  1. Review complete PLY ticket requirements in $ticket_doc_path"
echo "  2. Begin TDD implementation using Android/Kotlin patterns:"
echo "     - .tools/spectrum-dev tdd-red 'should [describe behavior]'"
echo "     - .tools/spectrum-dev tdd-green (implement minimal code)"
echo "     - .tools/spectrum-dev tdd-commit 'commit message'"
echo "  3. Use Android build commands:"
echo "     - ./gradlew testDebugUnitTest (run unit tests)"
echo "     - ./gradlew assembleDebug (build app)"
echo "     - ./gradlew ktlintCheck (style check)"
echo "  4. Commit work regularly and push feature branch when ready"
echo ""
echo -e "${MUSIC} Ready for pCloud Music Player Android development with TDD approach!"

# Clean up temp file if it was in temp location
if [[ "$downloaded_file" =~ ^(/tmp|./tmp) ]]; then
    echo -e "${INFO} Cleaning up temporary file: $downloaded_file"
    rm -f "$downloaded_file"
fi