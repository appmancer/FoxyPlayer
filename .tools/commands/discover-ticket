#!/bin/bash
# discover-ticket command for Spectrum Development Framework
# Phase 1: Ticket Discovery and Data Extraction (Android/Music Player version)
# Purpose: Extract ticket details from Slack, prepare temp file, set up for context reset

# Configuration
TICKET_INFO_FILE="./tmp/spectrum-ticket-info.json"

# Ensure tmp directory exists
mkdir -p ./tmp

# Colors and emoji
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
SUCCESS="✅"
ERROR="❌"
INFO="📋"
WORKING="🔄"
SEARCH="🔍"
DOWNLOAD="📥"
SAVE="💾"
RESET="🔄"
MUSIC="🎵"

echo -e "${INFO} ${BLUE}Spectrum Development Framework - Ticket Discovery${NC}"
echo -e "${MUSIC} ${YELLOW}pCloud Music Player Project - Phase 1: Discovery & Data Extraction${NC}"
echo ""

# Check if we already have ticket info
if [[ -f "$TICKET_INFO_FILE" ]]; then
    echo -e "${INFO} Found existing ticket info from previous discovery:"
    cat "$TICKET_INFO_FILE" | jq -r '"  Ticket: " + .ticket_id + " - " + .ticket_title'
    echo ""
    echo -e "${SUCCESS} Using existing ticket info"
    echo -e "${INFO} Ready for context reset and implementation phase"
    echo -e "${RESET} Next: Run ${YELLOW}.tools/spectrum-dev start-ticket${NC}"
    exit 0
fi

# Automated discovery for AI agents
echo -e "${SEARCH} Step 1: Automated Ticket Discovery"
echo -e "${INFO} ${YELLOW}=== AUTOMATED AI AGENT DISCOVERY ===${NC}"
echo ""

# Get recent Slack messages
echo -e "${WORKING} Checking Slack for ticket assignments..."
python3 .tools/slack_rest_client.py get_relevant_messages 10 > ./tmp/slack_messages.json

if [[ ! -s ./tmp/slack_messages.json ]]; then
    echo -e "${ERROR} Failed to fetch Slack messages"
    exit 1
fi

# Parse messages for music player ticket assignments - prioritize newest first
echo -e "${WORKING} Searching for pCloud Music Player ticket assignments..."

# Enhanced patterns for PLY-prefixed music player project tickets
ticket_assignment=$(jq -r '.result.messages[] | 
    select(.text | test("PLY-[0-9]+")) | 
    select(.text | test("assigned|Assignment|assignment|ready for.*implementation|ready for.*work|In Progress.*ready|music.*player|pcloud|audio|streaming|player"; "i")) | 
    .text' ./tmp/slack_messages.json 2>/dev/null | head -n 1)

if [[ -z "$ticket_assignment" || "$ticket_assignment" == "null" ]]; then
    echo -e "${ERROR} No PLY-prefixed music player ticket assignment found in recent messages"
    echo -e "${INFO} Looking for general PLY tickets..."
    
    # Fallback to general PLY ticket pattern
    ticket_assignment=$(jq -r '.result.messages[] | 
        select(.text | test("PLY-[0-9]+")) | 
        select(.text | test("assigned|Assignment|assignment|ready for.*implementation|ready for.*work|In Progress.*ready"; "i")) | 
        .text' ./tmp/slack_messages.json 2>/dev/null | head -n 1)
fi

if [[ -z "$ticket_assignment" || "$ticket_assignment" == "null" ]]; then
    echo -e "${ERROR} No ticket assignment found in recent messages"
    echo -e "${INFO} Recent messages summary:"
    jq -r '.result.messages[]? | "  " + .user_name + ": " + (.text | .[0:100])' ./tmp/slack_messages.json 2>/dev/null || echo "  No messages found"
    echo ""
    echo -e "${INFO} ${MUSIC} Waiting for pCloud Music Player ticket assignment from Lieutenant Green..."
    echo -e "${INFO} Expected ticket patterns:"
    echo "  - Music streaming functionality"
    echo "  - pCloud API integration"
    echo "  - Audio playback features"
    echo "  - Android UI components"
    echo "  - Background service implementation"
    exit 1
fi

echo -e "${SUCCESS} Found ticket assignment:"
echo -e "${INFO}   $ticket_assignment"
echo ""

# Extract ticket ID and title
ticket_id=$(echo "$ticket_assignment" | grep -oE 'PLY-[0-9]+' | head -n 1)
ticket_title=$(echo "$ticket_assignment" | sed -n 's/.*\(PLY-[0-9]\+\)[^:]*: *\(.*\)/\2/p' | head -n 1)

if [[ -z "$ticket_title" ]]; then
    # Try alternative extraction patterns for music player tickets
    ticket_title=$(echo "$ticket_assignment" | sed -n 's/.*assigned: *\*\*\(.*\)\*\*.*/\1/p' | head -n 1)
fi

if [[ -z "$ticket_title" ]]; then
    # Music player specific fallback
    if echo "$ticket_assignment" | grep -qi "music\|audio\|player\|pcloud\|stream"; then
        ticket_title="pCloud Music Player Feature"
    else
        ticket_title="Ticket Assignment Found"
    fi
fi

echo -e "${WORKING} Extracted information:"
echo -e "${INFO}   Ticket ID: ${BLUE}$ticket_id${NC}"
echo -e "${INFO}   Title: $ticket_title"
echo ""

# Check for file attachments in the messages
echo -e "${WORKING} Checking for ticket detail files..."
attachment_found=$(jq -r '.result.messages[] | select(.files and (.files | length > 0)) | .files[0].id // empty' ./tmp/slack_messages.json 2>/dev/null | head -n 1)

ticket_file_path="./tmp/discovered-ticket-details.md"

if [[ -n "$attachment_found" && "$attachment_found" != "null" ]]; then
    echo -e "${DOWNLOAD} Downloading ticket details file..."
    python3 .tools/slack_rest_client.py download_file "$attachment_found" "$ticket_file_path"
    
    if [[ -f "$ticket_file_path" && -s "$ticket_file_path" ]]; then
        echo -e "${SUCCESS} Downloaded ticket details to: $ticket_file_path"
    else
        echo -e "${ERROR} Failed to download file attachment"
        ticket_file_path=""
    fi
else
    echo -e "${INFO} No file attachments found, using message content as ticket details"
    
    # Extract detailed message content and save it with music player context
    echo "# pCloud Music Player - Ticket Assignment Details" > "$ticket_file_path"
    echo "" >> "$ticket_file_path"
    echo "**Ticket ID:** $ticket_id" >> "$ticket_file_path"
    echo "**Title:** $ticket_title" >> "$ticket_file_path"
    echo "**Project:** pCloud Music Player (Android)" >> "$ticket_file_path"
    echo "" >> "$ticket_file_path"
    echo "## Assignment Message" >> "$ticket_file_path"
    echo "$ticket_assignment" >> "$ticket_file_path"
    echo "" >> "$ticket_file_path"
    
    # Add any detailed messages from Lieutenant Green
    echo "## Additional Context" >> "$ticket_file_path"
    jq -r '.result.messages[] | select(.user_name == "Lieutenant Green") | select(.text | length > 200) | .text' ./tmp/slack_messages.json 2>/dev/null >> "$ticket_file_path"
    
    # Add music player specific context if relevant
    if echo "$ticket_assignment" | grep -qi "music\|audio\|player\|pcloud\|stream"; then
        echo "" >> "$ticket_file_path"
        echo "## Music Player Development Context" >> "$ticket_file_path"
        echo "- Project: Android pCloud Music Player" >> "$ticket_file_path"
        echo "- Technology Stack: Kotlin, Jetpack Compose, ExoPlayer/Media3" >> "$ticket_file_path"
        echo "- Architecture: MVVM with Repository pattern" >> "$ticket_file_path"
        echo "- Key Features: Streaming, offline caching, widgets, background playback" >> "$ticket_file_path"
        echo "- API Integration: pCloud REST API for file access" >> "$ticket_file_path"
    fi
fi

# Enhanced ticket type detection for music player project
ticket_type="backend"
if echo "$ticket_assignment" | grep -qi "research\|investigate\|analyze"; then
    ticket_type="research"
elif echo "$ticket_assignment" | grep -qi "architecture\|design\|specification"; then
    ticket_type="architecture"
elif echo "$ticket_assignment" | grep -qi "ui\|interface\|widget\|compose"; then
    ticket_type="frontend"
elif echo "$ticket_assignment" | grep -qi "api\|service\|background\|streaming\|audio"; then
    ticket_type="backend"
fi

# Music player specific categorization
music_category="general"
if echo "$ticket_assignment" | grep -qi "stream\|play\|audio\|media"; then
    music_category="playback"
elif echo "$ticket_assignment" | grep -qi "pcloud\|api\|network"; then
    music_category="integration"
elif echo "$ticket_assignment" | grep -qi "ui\|widget\|interface\|compose"; then
    music_category="ui"
elif echo "$ticket_assignment" | grep -qi "background\|service\|notification"; then
    music_category="service"
fi

echo -e "${WORKING} Creating ticket info file..."

# Create the ticket info JSON file with music player enhancements
cat > "$TICKET_INFO_FILE" << EOF
{
  "ticket_id": "$ticket_id",
  "ticket_title": "$ticket_title",
  "ticket_file": "$ticket_file_path",
  "ticket_type": "$ticket_type",
  "project": "pcloud-music-player",
  "platform": "android",
  "music_category": "$music_category",
  "discovered_at": "$(date -Iseconds)",
  "discovered_by": "Captain-Scarlet"
}
EOF

echo -e "${SUCCESS} Created ticket info file: $TICKET_INFO_FILE"
echo ""

# Clean up temp files
rm -f ./tmp/slack_messages.json

# Validate that discovery was completed
if [[ ! -f "$TICKET_INFO_FILE" ]]; then
    echo -e "${ERROR} Ticket info file not found: $TICKET_INFO_FILE"
    echo -e "${INFO} Please complete the discovery process and create the ticket info file"
    echo -e "${INFO} Re-run this command when discovery is complete"
    exit 1
fi

# Validate ticket info file format
if ! jq -e . "$TICKET_INFO_FILE" >/dev/null 2>&1; then
    echo -e "${ERROR} Invalid JSON format in ticket info file"
    echo -e "${INFO} Please check the JSON syntax and try again"
    exit 1
fi

# Extract and validate required fields
ticket_id=$(jq -r '.ticket_id // empty' "$TICKET_INFO_FILE")
ticket_title=$(jq -r '.ticket_title // empty' "$TICKET_INFO_FILE")
ticket_file=$(jq -r '.ticket_file // empty' "$TICKET_INFO_FILE")

if [[ -z "$ticket_id" || -z "$ticket_title" || -z "$ticket_file" ]]; then
    echo -e "${ERROR} Missing required fields in ticket info file"
    echo -e "${INFO} Required: ticket_id, ticket_title, ticket_file"
    echo -e "${INFO} Current content:"
    cat "$TICKET_INFO_FILE"
    exit 1
fi

# Validate ticket file exists
if [[ ! -f "$ticket_file" ]]; then
    echo -e "${ERROR} Ticket file not found: $ticket_file"
    echo -e "${INFO} Please ensure the downloaded ticket file exists"
    exit 1
fi

# Validate ticket file has content
if [[ ! -s "$ticket_file" ]]; then
    echo -e "${ERROR} Ticket file is empty: $ticket_file"
    exit 1
fi

# Success summary
echo -e "${SUCCESS} ${MUSIC} pCloud Music Player ticket discovery completed successfully!"
echo -e "${INFO} Discovery Summary:"
echo -e "  Ticket: ${BLUE}$ticket_id${NC} - $ticket_title"
echo -e "  Type: $ticket_type (Category: $music_category)"
echo -e "  Project: pCloud Music Player (Android)"
echo -e "  File: $ticket_file ($(wc -l < "$ticket_file") lines)"
echo -e "  Info: $TICKET_INFO_FILE"
echo ""

# Ready for implementation instructions
echo -e "${RESET} ${YELLOW}=== READY FOR ANDROID MUSIC PLAYER IMPLEMENTATION ===${NC}"
echo -e "${INFO} Discovery phase complete - ticket data prepared for Android development"
echo -e "${INFO} Now ready for clean implementation phase with:"
echo "  - Kotlin/Android development patterns"
echo "  - Jetpack Compose UI framework"
echo "  - Media3/ExoPlayer for audio playback"
echo "  - pCloud API integration"
echo ""
echo -e "${YELLOW}Next Steps:${NC}"
echo -e "${RESET} 1. Run: ${BLUE}.tools/spectrum-dev start-ticket${NC} (Android project setup)"
echo -e "${RESET} 2. Optional: Clear conversation context manually if desired"
echo ""
echo -e "${SUCCESS} ${MUSIC} Ready for pCloud Music Player development!"